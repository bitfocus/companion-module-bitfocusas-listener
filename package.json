{
	"name": "bitfocusas-listener",
	"version": "1.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"package": "npm run build && companion-module-build",
		"build": "rimraf dist && npm run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "npm run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-bitfocusas-listener.git"
	},
	"engines": {
		"node": "22",
		"packageManager": "yarn@4.17.1"
	},
	"dependencies": {
		"@companion-module/base": "^1.14.1",
		"ws": "^8.21.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@companion-module/tools": "^2.8.0",
		"@types/node": "^22.20.1",
		"@types/ws": "^8.18.1",
		"eslint": "^9.39.5",
		"husky": "^9.1.7",
		"lint-staged": "^15.5.2",
		"prettier": "^3.9.6",
		"rimraf": "^6.1.3",
		"typescript": "~5.5.4",
		"typescript-eslint": "^8.65.0"
	},
	"packageManager": "yarn@4.17.1",
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"echo 'staging prettier'"
		],
		"*.{ts,tsx,js,jsx}": [
			"echo 'staging lint'"
		]
	}
}
